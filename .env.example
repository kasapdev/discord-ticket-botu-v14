# ═══════════════════════════════════════════════════════════════
# METETICKET BOT - Ortam Degiskenleri Ornegi
# kasapac tarafindan yapilmistir.
# Bu dosyayi kopyalayip .env olarak kaydedin ve degerleri doldurun.
# ═══════════════════════════════════════════════════════════════

# ── Discord Bot Bilgileri (ZORUNLU) ─────────────────────────────
# Discord Developer Portal'dan alin: https://discord.com/developers/applications
DISCORD_TOKEN=BOT_TOKEN_BURAYA
CLIENT_ID=BOT_CLIENT_ID_BURAYA

# ── Guild-Only Mod (TEK SUNUCU) ──────────────────────────────────
# Botun sadece bu sunucuda calismasini saglar.
# Komutlar anlik olarak bu guild'e kaydedilir (global yerine).
# Bos birakılırsa bot tum sunucularda calisir (global mod).
GUILD_ID=

# ── Sunucu Bilgileri ─────────────────────────────────────────────
# Botun calisacagi sunucunun adi (embed ve mesajlarda gorunur)
SERVER_NAME=Sunucu Adi

# Destek sunucusu davet linki (ticket panelinde gorunur)
SUPPORT_SERVER=https://discord.gg/

# ── Ticket Sistemi ───────────────────────────────────────────────
# Ticket panel basliginda gorunecek ana isim
TICKET_SYSTEM_NAME=Destek Sistemi

# Ticket acildiginda kullaniciya gonderilecek karsilama mesaji
TICKET_WELCOME_MESSAGE=Merhaba! Destek talebiniz alindi. Yetkililerimiz en kisa surede size yardimci olacaktir.

# Destek yetkilileri rolu ID (setup komutuyla da ayarlanabilir)
STAFF_ROLE_ID=

# Ticket kategorisi ID (setup komutuyla da ayarlanabilir)
TICKET_CATEGORY_ID=

# Ticket log kanali ID (setup komutuyla da ayarlanabilir)
TICKET_LOG_CHANNEL_ID=

# Transcript kanali ID (setup komutuyla da ayarlanabilir)
TRANSCRIPT_CHANNEL_ID=

# ── Moderasyon ───────────────────────────────────────────────────
# Moderasyon log kanali ID (setup komutuyla da ayarlanabilir)
MOD_LOG_CHANNEL_ID=

# ── Guard Sistemi ────────────────────────────────────────────────
# Guard log kanali ID (setup komutuyla da ayarlanabilir)
GUARD_LOG_CHANNEL_ID=

# Guard sistemini aktif/pasif yap (true/false)
GUARD_ENABLED=true